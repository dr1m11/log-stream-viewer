# Log Stream Viewer — environment variables
#
# Copy to `.env.local` and fill in values. Never commit real values.
#
# Web app (apps/web), read at build time by Vite.
# WebSocket endpoint of the mock server; defaults to the local dev server.
# VITE_STREAM_URL=ws://localhost:8787/ws
#
# Mock server (apps/mock-server), parsed by apps/mock-server/src/config.ts. Defaults suit local
# development; see docs/adr/0005 for the limits.
# NODE_ENV=production        # requires ALLOWED_ORIGINS, rejects requests without Origin, HOST 0.0.0.0
# PORT=8787
# HOST=127.0.0.1             # 0.0.0.0 when NODE_ENV=production
# Comma-separated exact origins (scheme://host[:port]) and/or anchored regexes (^…$, no commas).
# Default: http://localhost:5173, http://localhost:4173, http://127.0.0.1:5173, http://127.0.0.1:4173
# ALLOWED_ORIGINS=https://app.example.dev,^https://pr-\d+-app\.example\.dev$
# DEFAULT_RATE=200
# MAX_RATE=20000
# MAX_CONNECTIONS=50
# MAX_CONNECTIONS_PER_IP=3
# GLOBAL_MAX_EVENTS_PER_SEC=20000
# SESSION_MAX_MS=1800000
# GIT_SHA=dev
