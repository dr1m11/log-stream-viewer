# Log Stream Viewer — environment variables
#
# Copy to `.env.local` and fill in values. Never commit real values.
#
# Web app (apps/web), read at build time by Vite.
# WebSocket endpoint of the mock server; defaults to the local dev server.
# VITE_STREAM_URL=ws://localhost:8787/ws
#
# Mock server (apps/mock-server). Defaults suit local development.
# PORT=8787
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# MAX_RATE=20000
