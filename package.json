{
  "name": "log-stream-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time log stream viewer: WebSocket stream, virtualized table for 100K+ rows, search in a Web Worker",
  "license": "MIT",
  "author": "Marat Gabdrashitov",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lsv/mock-server --filter @lsv/web dev",
    "dev:web": "pnpm --filter @lsv/web dev",
    "dev:server": "pnpm --filter @lsv/mock-server dev",
    "build": "pnpm --recursive --if-present build",
    "build:local": "pnpm --filter @lsv/web build:local",
    "preview": "pnpm --filter @lsv/web preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fsd": "pnpm --recursive --if-present lint:fsd",
    "typecheck": "tsc -p tsconfig.json && pnpm --recursive --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run --reporter=verbose",
    "test:e2e": "pnpm --recursive --if-present test:e2e",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\" \"scripts/*.test.mjs\" \"scripts/*.test.ts\"",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:fsd && pnpm typecheck && pnpm test && pnpm test:hooks && pnpm build:local",
    "verify:full": "pnpm verify && pnpm test:e2e",
    "ports:free": "node scripts/free-ports.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-react/eslint-plugin": "5.26.1",
    "@eslint/js": "10.0.1",
    "@lsv/protocol": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "ws": "8.22.0"
  }
}
