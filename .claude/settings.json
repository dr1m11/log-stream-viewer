{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm dev*)",
      "Bash(pnpm verify*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm preview*)",
      "Bash(pnpm format*)",
      "Bash(pnpm lhci*)",
      "Bash(pnpm serve:demo*)",
      "Bash(pnpm ports:free*)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec steiger *)",
      "Bash(pnpm exec playwright test*)",
      "Bash(pnpm --filter * exec vitest *)",
      "Bash(pnpm --filter * exec tsc *)",
      "Bash(pnpm --filter * exec eslint *)",
      "Bash(pnpm --filter * exec playwright test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git rev-parse*)",
      "Bash(git stash list*)",
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * show*)",
      "Bash(git -C * branch*)",
      "Bash(git -C * switch*)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * fetch*)",
      "Bash(git -C * rev-parse*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(npx ctx7@latest *)",
      "Bash(fly status*)",
      "Bash(fly logs --no-tail*)",
      "Bash(fly releases*)",
      "Bash(flyctl status*)",
      "Bash(flyctl logs --no-tail*)",
      "Bash(flyctl releases*)",
      "Bash(curl -s http://localhost:*)",
      "mcp__chrome-devtools"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git -C * rebase*)",
      "Bash(git clean*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(gh label *)",
      "Bash(gh issue create*)",
      "Bash(gh release *)",
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Bash(pnpm up*)",
      "Bash(pnpm update*)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm exec wrangler *)",
      "Bash(pnpm --filter * exec wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(fly deploy*)",
      "Bash(fly secrets*)",
      "Bash(fly scale*)",
      "Bash(fly apps*)",
      "Bash(fly machine*)",
      "Bash(flyctl deploy*)",
      "Bash(flyctl secrets*)",
      "Bash(flyctl scale*)",
      "Bash(flyctl apps*)",
      "Bash(flyctl machine*)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/.dev.vars*)",
      "Edit(./pnpm-lock.yaml)",
      "Write(./pnpm-lock.yaml)"
    ]
  },
  "enabledMcpjsonServers": ["chrome-devtools"],
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-lint.mjs"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-typecheck.mjs"],
            "timeout": 180
          }
        ]
      }
    ]
  }
}
